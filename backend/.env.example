PORT=5000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=replace-with-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_NAME=Chief Admin
# These values are local-development placeholders only. Production rejects them.
# Radius expansion interval in seconds (prototype demo timings; use e.g. 300/600/900 in production)
EXPAND_CRITICAL_SECONDS=7
EXPAND_MODERATE_SECONDS=11
EXPAND_MILD_SECONDS=17
